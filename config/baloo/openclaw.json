{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    },
    "controlUi": {
      "enabled": true
    }
  },
  "models": {
    "providers": {
      "anthropic": {
        "models": [
          {
            "id": "claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "cost": { "input": 3, "output": 15, "cacheRead": 0.3, "cacheWrite": 3.75 }
          }
        ]
      },
      "openai": {
        "models": [
          {
            "id": "gpt-5.5",
            "name": "GPT-5.5",
            "cost": { "input": 5, "output": 30, "cacheRead": 0.5, "cacheWrite": 0 }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "skipBootstrap": true,
      "model": {
        "primary": "openai/gpt-5.5",
        "fallbacks": ["anthropic/claude-sonnet-4-6"]
      },
      "heartbeat": { "every": "0m" },
      "userTimezone": "Europe/Bucharest",
      "imageGenerationModel": {
        "primary": "openai/gpt-image-2",
        "timeoutMs": 180000
      }
    },
    "list": [
      {
        "id": "direct-message",
        "name": "Baloo",
        "default": true,
        "workspace": "/git/link/config/baloo/agents/direct-message",
        "tools": {
          "allow": [
            "web_fetch",
            "browser",
            "image_generate",
            "session_status",
            "searxng__searxng_web_search",
            "google-maps__*",
            "google-timezone__lookup",
            "trek__*",
            "hass__*",
            "github-life__add_issue_comment",
            "github-life__create_branch",
            "github-life__create_issue",
            "github-life__create_or_update_file",
            "github-life__create_pull_request",
            "github-life__get_file_contents",
            "github-life__get_issue",
            "github-life__get_pull_request",
            "github-life__get_pull_request_comments",
            "github-life__get_pull_request_files",
            "github-life__get_pull_request_reviews",
            "github-life__get_pull_request_status",
            "github-life__list_commits",
            "github-life__list_issues",
            "github-life__list_pull_requests",
            "github-life__search_code",
            "github-life__search_issues",
            "github-life__search_repositories",
            "github-life__search_users",
            "github-life__update_issue",
            "github-life__update_pull_request_branch",
            "cron",
            "k8s__kubectl_describe",
            "k8s__kubectl_get",
            "k8s__kubectl_logs"
          ],
          "deny": [
            "github-life__create_repository",
            "github-life__fork_repository",
            "github-life__merge_pull_request",
            "github-life__push_files",
            "k8s__exec_in_pod",
            "k8s__install_helm_chart",
            "k8s__kubectl_apply",
            "k8s__kubectl_create",
            "k8s__kubectl_patch",
            "k8s__kubectl_rollout",
            "k8s__kubectl_scale",
            "k8s__port_forward",
            "k8s__stop_port_forward",
            "k8s__upgrade_helm_chart"
          ]
        }
      },
      {
        "id": "interior-designer",
        "name": "Baloo Interior Designer",
        "workspace": "/git/link/config/baloo/agents/interior-designer",
        "tools": {
          "allow": [
            "web_fetch",
            "browser",
            "session_status",
            "searxng__searxng_web_search"
          ],
          "deny": [
            "hass__*",
            "github-life__*",
            "trek__*",
            "google-maps__*",
            "google-timezone__*",
            "k8s__*",
            "cron",
            "image_generate"
          ]
        }
      },
      {
        "id": "cooking",
        "name": "Baloo Shef",
        "workspace": "/git/link/config/baloo/agents/cooking",
        "tools": {
          "allow": [
            "web_fetch",
            "browser",
            "searxng__searxng_web_search",
            "github-life__create_branch",
            "github-life__create_or_update_file",
            "github-life__create_pull_request",
            "github-life__get_file_contents",
            "hass__GetDateTime",
            "hass__GetLiveContext"
          ],
          "deny": [
            "trek__*",
            "google-maps__*",
            "google-timezone__*",
            "image_generate",
            "k8s__*"
          ]
        }
      },
      {
        "id": "garden",
        "name": "Baloo Grădinar",
        "workspace": "/git/link/config/baloo/agents/garden",
        "heartbeat": {
          "every": "1h",
          "target": "whatsapp",
          "to": "${BALOO_GARDEN_GROUP}",
          "isolatedSession": true,
          "lightContext": true,
          "activeHours": { "start": "08:00", "end": "10:00" }
        },
        "tools": {
          "allow": [
            "web_fetch",
            "browser",
            "session_status",
            "searxng__searxng_web_search",
            "github-life__create_branch",
            "github-life__create_or_update_file",
            "github-life__create_pull_request",
            "github-life__get_file_contents",
            "hass__GetDateTime",
            "hass__GetLiveContext"
          ],
          "deny": [
            "trek__*",
            "google-maps__*",
            "google-timezone__*",
            "image_generate",
            "k8s__*"
          ]
        }
      },
      {
        "id": "trips",
        "name": "Baloo Trips",
        "workspace": "/git/link/config/baloo/agents/trips",
        "tools": {
          "allow": [
            "trek__*",
            "session_status",
            "searxng__searxng_web_search",
            "google-maps__*",
            "google-timezone__lookup",
            "web_fetch",
            "browser"
          ],
          "deny": [
            "hass__*",
            "github-life__*",
            "image_generate",
            "k8s__*",
            "trek__create_trip",
            "trek__delete_trip"
          ]
        }
      },
      {
        "id": "main",
        "name": "Baloo Root",
        "workspace": "/git/link/config/baloo/agents/main",
        "tools": {
          "allow": [],
          "deny": [
            "hass__*",
            "github-life__*",
            "trek__*",
            "google-maps__*",
            "google-timezone__*",
            "image_generate",
            "k8s__*",
            "browser"
          ]
        }
      }
    ]
  },
  "bindings": [
    {
      "agentId": "direct-message",
      "match": {
        "channel": "whatsapp",
        "peer": { "kind": "direct", "id": "${BALOO_OWNER_PHONE}" }
      }
    },
    {
      "agentId": "direct-message",
      "match": {
        "channel": "whatsapp",
        "peer": { "kind": "direct", "id": "${KINGA_PHONE}" }
      }
    },
    {
      "agentId": "cooking",
      "match": {
        "channel": "whatsapp",
        "peer": { "kind": "group", "id": "${BALOO_SHEF_GROUP}" }
      }
    },
    {
      "agentId": "garden",
      "match": {
        "channel": "whatsapp",
        "peer": { "kind": "group", "id": "${BALOO_GARDEN_GROUP}" }
      }
    },
    {
      "agentId": "trips",
      "match": {
        "channel": "whatsapp",
        "peer": { "kind": "group", "id": "${BALOO_TRIPS_PALKOEK_GROUP}" }
      }
    }
  ],
  "channels": {
    "whatsapp": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": ["${BALOO_OWNER_PHONE}", "${KINGA_PHONE}"]
    }
  },
  "diagnostics": {
    "stuckSessionWarnMs": 60000,
    "stuckSessionAbortMs": 300000
  },
  "cron": { "enabled": true },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "plugins": {
    "allow": ["whatsapp", "browser"]
  },
  "browser": {
    "enabled": true,
    "defaultProfile": "cluster",
    "profiles": {
      "cluster": {
        "cdpUrl": "ws://browser.baloo.svc.cluster.local:3000?token=${BROWSER_CDP_TOKEN}",
        "attachOnly": true,
        "color": "#FF4500"
      }
    },
    "ssrfPolicy": {
      "allowedHostnames": ["browser.baloo.svc.cluster.local"]
    }
  },
  "mcp": {
    "sessionIdleTtlMs": 3600000,
    "servers": {
      "searxng": {
        "url": "http://mcp-searxng.baloo.svc.cluster.local:3000/mcp",
        "transport": "streamable-http"
      },
      "google-maps": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-google-maps"],
        "env": {
          "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}"
        }
      },
      "google-timezone": {
        "command": "node",
        "args": ["/git/link/config/baloo/tools/google-timezone-mcp.js"],
        "env": {
          "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}"
        },
        "timeout": 10,
        "supportsParallelToolCalls": true,
        "toolFilter": {
          "include": ["lookup"]
        }
      },
      "github-life": {
        "command": "node",
        "args": ["/git/link/config/baloo/tools/github-mcp-proxy.js"],
        "env": {
          "GITHUB_APP_ID": "${GITHUB_APP_ID}",
          "GITHUB_APP_INSTALLATION_ID": "${GITHUB_APP_INSTALLATION_ID}",
          "GITHUB_APP_PRIVATE_KEY_FILE": "/var/run/secrets/github-app/private-key.pem"
        }
      },
      "trek": {
        "command": "node",
        "args": ["/git/link/config/baloo/tools/trek-mcp-proxy.js"],
        "env": {
          "TREK_CLIENT_ID": "${TREK_CLIENT_ID}",
          "TREK_CLIENT_SECRET": "${TREK_CLIENT_SECRET}"
        }
      },
      "hass": {
        "url": "http://192.168.1.102:8123/mcp_server/sse",
        "transport": "sse",
        "headers": {
          "Authorization": "Bearer ${HA_TOKEN}"
        }
      },
      "k8s": {
        "url": "http://mcp-k8s.baloo.svc.cluster.local:3000/mcp",
        "transport": "streamable-http"
      }
    }
  },
  "tools": {
    "media": {
      "audio": {
        "enabled": true,
        "echoTranscript": true,
        "echoFormat": "🎙️ \"{transcript}\"",
        "models": [
          {
            "type": "cli",
            "command": "python3",
            "args": ["/git/link/config/baloo/whisper-transcribe.py", "{{MediaPath}}"],
            "capabilities": ["audio"],
            "timeoutSeconds": 600
          }
        ]
      }
    }
  }
}
