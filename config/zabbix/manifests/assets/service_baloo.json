{
  "interval": 900,
  "deadline": 25,
  "url": "http://mcp-k8s.baloo.svc.cluster.local:3000/mcp",
  "required_tools": [
    "kubectl_get",
    "kubectl_describe",
    "kubectl_logs",
    "list_api_resources"
  ],
  "failure_grace_seconds": 1800,
  "minimum_failure_observations": 2,
  "minimum_recovery_observations": 2,
  "severity": 3,
  "notification": "page",
  "workloads": [
    {
      "namespace": "baloo",
      "kind": "Deployment",
      "name": "mcp-k8s"
    }
  ]
}
