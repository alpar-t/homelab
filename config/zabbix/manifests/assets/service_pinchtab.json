{
  "interval": 900,
  "deadline": 30,
  "targets": [
    {
      "name": "general web",
      "deployment": "pinchtab-web"
    },
    {
      "name": "OLX",
      "deployment": "pinchtab"
    }
  ],
  "namespace": "baloo",
  "failure_grace_seconds": 1800,
  "minimum_failure_observations": 2,
  "minimum_recovery_observations": 2,
  "severity": 3,
  "notification": "page",
  "workloads": [],
  "check_workloads": {
    "PinchTab general web": [
      {
        "namespace": "baloo",
        "kind": "Deployment",
        "name": "pinchtab-web"
      }
    ],
    "PinchTab OLX": [
      {
        "namespace": "baloo",
        "kind": "Deployment",
        "name": "pinchtab"
      }
    ]
  }
}
