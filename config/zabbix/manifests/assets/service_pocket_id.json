{
  "interval": 600,
  "deadline": 25,
  "internal_url": "http://pocket-id.pocket-id.svc.cluster.local",
  "issuer": "https://auth.newjoy.ro",
  "endpoints": {
    "authorization_endpoint": "https://auth.newjoy.ro/authorize",
    "token_endpoint": "https://auth.newjoy.ro/api/oidc/token",
    "jwks_uri": "https://auth.newjoy.ro/.well-known/jwks.json"
  },
  "proxies": [
    {
      "name": "portal",
      "url": "http://oauth2-proxy.portal.svc.cluster.local:4180",
      "client_id": "portal",
      "callback": "https://portal.newjoy.ro/oauth2/callback"
    },
    {
      "name": "search",
      "url": "http://oauth2-proxy-search.baloo.svc.cluster.local:4180",
      "client_id": "searxng-search",
      "callback": "https://search.newjoy.ro/oauth2/callback"
    }
  ],
  "failure_grace_seconds": 900,
  "minimum_failure_observations": 2,
  "minimum_recovery_observations": 2,
  "severity": 3,
  "notification": "page",
  "workloads": [],
  "check_workloads": {
    "Pocket ID OIDC metadata and signing keys": [
      {
        "namespace": "pocket-id",
        "kind": "Deployment",
        "name": "pocket-id"
      }
    ],
    "Pocket ID sign-in proxy portal": [
      {
        "namespace": "portal",
        "kind": "Deployment",
        "name": "oauth2-proxy"
      }
    ],
    "Pocket ID sign-in proxy search": [
      {
        "namespace": "baloo",
        "kind": "Deployment",
        "name": "oauth2-proxy-search"
      }
    ]
  }
}
