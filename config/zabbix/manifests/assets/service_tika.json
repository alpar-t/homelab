{
  "interval": 1800,
  "deadline": 30,
  "instances": [
    {
      "name": "Paperless",
      "url": "http://tika.paperless-ngx.svc.cluster.local:9998/tika"
    },
    {
      "name": "OpenCloud",
      "url": "http://opencloud-tika.opencloud.svc.cluster.local:9998/tika"
    }
  ],
  "failure_grace_seconds": 3600,
  "minimum_failure_observations": 2,
  "minimum_recovery_observations": 2,
  "severity": 3,
  "notification": "page",
  "workloads": [],
  "check_workloads": {
    "Tika Paperless text extraction": [
      {
        "namespace": "paperless-ngx",
        "kind": "Deployment",
        "name": "tika"
      }
    ],
    "Tika OpenCloud text extraction": [
      {
        "namespace": "opencloud",
        "kind": "Deployment",
        "name": "opencloud-tika"
      }
    ]
  }
}
