{
  "interval": 600,
  "deadline": 30,
  "locations": [
    "default"
  ],
  "validation_max_age": 900,
  "daily_schedules": {
    "velero-daily-resources": {
      "hour_utc": 4,
      "minute": 0,
      "grace_seconds": 7200
    }
  },
  "failure_grace_seconds": 900,
  "minimum_failure_observations": 2,
  "minimum_recovery_observations": 2,
  "severity": 3,
  "notification": "page",
  "workloads": [
    {
      "namespace": "velero",
      "kind": "Deployment",
      "name": "velero"
    }
  ]
}
