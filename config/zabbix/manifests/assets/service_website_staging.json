{
  "interval": 1800,
  "deadline": 30,
  "internal_url": "http://website.newjoy-website-staging.svc.cluster.local/",
  "public_url": "https://staging.newjoy.ro/",
  "issuer_host": "auth.newjoy.ro",
  "marker": "New Joy Interior Design",
  "failure_grace_seconds": 3600,
  "minimum_failure_observations": 2,
  "minimum_recovery_observations": 2,
  "severity": 2,
  "notification": "dashboard",
  "workloads": [],
  "check_workloads": {
    "Staging homepage and asset": [
      {
        "namespace": "newjoy-website-staging",
        "kind": "Deployment",
        "name": "website"
      }
    ],
    "Staging environment": [
      {
        "namespace": "newjoy-website-staging",
        "kind": "Deployment",
        "name": "website"
      }
    ],
    "Staging public sign-in gate": [
      {
        "namespace": "newjoy-website-staging",
        "kind": "Deployment",
        "name": "oauth2-proxy"
      }
    ]
  }
}
